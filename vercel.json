{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 300 },
    "api/cron.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 6 * * *" }
  ]
}
