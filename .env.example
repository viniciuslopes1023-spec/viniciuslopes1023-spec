# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Login (if ADMIN_PASSWORD is empty, a random one is generated and printed on first start)
ADMIN_EMAIL=admin@gringa.local
ADMIN_PASSWORD=

# Auth
SESSION_HOURS=72
# JWT_SECRET=use-a-long-random-string-here

# Automation
SCAN_INTERVAL_HOURS=6
SCAN_MIN_INTERVAL_MINUTES=15
REGIONS_PER_RUN=3
MAX_RESULTS_PER_REGION=30

# Public sources (politeness limits)
OVERPASS_TIMEOUT_MS=90000
OVERPASS_DELAY_MS=5000
WEBSITE_TIMEOUT_MS=15000
WEBSITE_PROBE_CONCURRENCY=3
